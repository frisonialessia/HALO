# Copia este archivo a .env.local y rellena con tus claves reales.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# --- Supabase (base de datos + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Publishable key (la nueva nomenclatura de Supabase, antes "anon key").
# Seguro de exponer al navegador — respeta las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
# Service role key — opcional, solo si necesitas saltarte RLS desde
# API routes server-side. NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Motores de IA ---
# Cada motor se activa SOLO si tiene su clave: basta con rellenarla aquí
# (y en Vercel) para que entre en la medición, sin tocar código.
PERPLEXITY_API_KEY=tu-clave-perplexity
# ChatGPT con búsqueda web (Responses API). Rellena la clave para activarlo.
OPENAI_API_KEY=
# Modelo de OpenAI a usar; debe soportar la herramienta web_search.
# Opcional — por defecto gpt-5.5.
OPENAI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Coste / rendimiento ---
# Nº de búsquedas por análisis real (cada una = 1 llamada de pago por motor).
# Por defecto 10; baja a 6 para gastar ~40% menos créditos.
HALO_PROBE_COUNT=
